+class ImomSolver {
+public:
+  int m; double c, sc;
+  std::vector<double> A, H, L;                      // m x m
+  std::vector<double> vecbuf;                       // all length-m work vectors, one allocation
+  double *b, *r, *g, *step, *tn, *w1, *w2, *w3, *ols;
