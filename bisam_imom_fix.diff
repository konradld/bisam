+  IntegerVector m; NumericVector calls, secs;
+  for (int i = 0; i < 64; i++) if (g_mode_calls[i] > 0) { m.push_back(i); calls.push_back(g_mode_calls[i]); secs.push_back(g_mode_secs[i]); }
