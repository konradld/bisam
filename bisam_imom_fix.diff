+      tnew = s * best_positive_min(a, s * bb, c, ystart, &gp);
+    }
+    double d = tnew - th[i];
+    add_col(r, i, d);
+    th[i] = tnew;
+    return std::fabs(d) / (1.0 + std::fabs(tnew));
