+% Generated by roxygen2: do not edit by hand
+% Please edit documentation in R/pip_window_fun.R
+\name{pip_window}
+\alias{pip_window}
+\title{Break detection with posterior inclusion probabilities over time windows}
+\usage{
+pip_window(
+  mod,
+  win_size,
+  op = c(">=", "=="),
+  pip_threshold = list(c0 = 1, c1 = 1, kappa = 1/3),
+  cred_int = 0.95
+)
+}
+\arguments{
+\item{mod}{Output of \code{\link{estimate_bisam}}.}
+
+\item{win_size}{Window length (number of consecutive periods).}
+
+\item{op}{\code{">="}: probability of at least one break in the window; \code{"=="}:
+probability of exactly one.}
+
+\item{pip_threshold}{Either a number, or a list with \code{c0}, \code{c1}, \code{kappa}
+giving the threshold \code{(c1 + kappa (win_size - 1)) / (c0 + c1)}.}
+
+\item{cred_int}{Coverage of the credible interval for the summed break size in a window.}
+}
+\value{
+A data frame with one row per detected window: unit, period, start and end time,
+  posterior mean (\code{MAP}) and credible interval of the summed break size, \code{PIP},
+  sign purity of the break sizes, and position indices.
+}
+\description{
+Summarises the break indicators of an \code{\link{estimate_bisam}} fit over sliding windows
+of \code{win_size} consecutive periods per unit, and reports the windows whose posterior
+probability of containing a break exceeds a threshold.
+}
