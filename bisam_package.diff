@@ -0,0 +1,175 @@
+% Generated by roxygen2: do not edit by hand
+% Please edit documentation in R/estimate_bisam_fun.R
+\name{estimate_bisam}
+\alias{estimate_bisam}
+\title{Estimate a Bayesian indicator saturated model (BISAM)}
+\usage{
+estimate_bisam(
+  data,
+  do_constant = FALSE,
+  do_individual_fe = FALSE,
+  do_time_fe = FALSE,
+  y_index = 3,
+  i_index = 1,
+  t_index = 2,
+  do_center_y = FALSE,
+  do_scale_y = FALSE,
+  do_center_x = FALSE,
+  do_scale_x = FALSE,
+  Ndraw = 10^4L,
+  Nburn = 2000L,
+  beta_prior = "g",
+  step_size_prior = c("mom", "imom"),
+  imom_marginal = c("ala_legacy", "ala", "laplace"),
+  rnlp_iter = 25L,
+  step_incl_prior = c("bern", "beta_bern"),
+  beta_variance_scale = 1000,
+  sigma2_shape = NULL,
+  sigma2_rate = NULL,
+  sigma2_hyper_p = 0.9,
+  step_incl_prob = 0.5,
+  step_incl_alpha = 1,
+  step_incl_beta = 1,
+  step_size_scale = 0.348,
+  cred_int = 0.95,
+  do_split_Z = TRUE,
+  do_cluster_s2 = FALSE,
+  do_sv = FALSE,
+  sv_prior_mu_mean = NULL,
+  sv_prior_mu_var = 100,
+  sv_prior_phi_a = 20,
+  sv_prior_phi_b = 1.5,
+  sv_prior_sigma_shape = 2.5,
+  sv_prior_sigma_rate = 0.025,
+  sv_backend = c("internal", "stochvol"),
+  do_check_outlier = FALSE,
+  outlier_prior = c("imom", "norm"),
+  outlier_incl_alpha = 1,
+  outlier_incl_beta = 10,
+  outlier_scale = 10,
+  steps_to_check = "all",
+  do_sparse_computation = FALSE,
+  do_geweke_test = FALSE
+)
+}
+\arguments{
+\item{data}{Data frame or matrix with unit index, time index, response and covariates.}
+
+\item{do_constant, do_individual_fe, do_time_fe}{Include a constant, unit fixed effects and/or
+time fixed effects. With both fixed effects and no constant the first unit effect is dropped.}
+
+\item{y_index, i_index, t_index}{Column positions of the response, unit and time index.}
+
+\item{do_center_y, do_scale_y, do_center_x, do_scale_x}{Centre/scale the response and covariates.}
+
+\item{Ndraw}{Total number of Gibbs iterations (including burn-in).}
+
+\item{Nburn}{Number of burn-in iterations (must be smaller than \code{Ndraw}).}
+
+\item{beta_prior}{Prior for the regression coefficients: \code{"g"} (Zellner's g-prior),
+\code{"f"} (fractional prior centred at a robust OLS fit), \code{"f_indep"} (fractional mean
+with independent variances) or \code{"flasso"} (centred at a LASSO fit; needs \pkg{glmnet}).}
+
+\item{step_size_prior}{Non-local prior on the break sizes: \code{"mom"} (product MOM) or
+\code{"imom"} (product iMOM).}
+
+\item{imom_marginal}{Integrated likelihood for the iMOM prior in the break-indicator step:
+\code{"ala_legacy"} (default; approximate Laplace approximation at the posterior mode found
+by mombf's coordinate iteration, as in mombf 3.5.4), \code{"ala"} (the same at a
+near-global posterior mode; more accurate, 1.5-3.5 times slower) or \code{"laplace"}
+(Laplace approximation with the Hessian at the near-global mode). Ignored for MOM.}
+
+\item{rnlp_iter}{Number of Gibbs iterations used to draw a unit's break sizes after its set
+of breaks changed (otherwise one iteration is used); see Details.}
+
+\item{step_incl_prior}{Prior on the break indicators: \code{"bern"} (Bernoulli with
+probability \code{step_incl_prob}) or \code{"beta_bern"} (Beta-Bernoulli with parameters
+\code{step_incl_alpha}, \code{step_incl_beta}).}
+
+\item{beta_variance_scale}{Variance scaling of the coefficient prior (g in the g-prior).}
+
+\item{sigma2_shape, sigma2_rate}{Inverse gamma prior on the residual variance. If either is
+\code{NULL}, a data-based prior is used with shape 3 and P(sigma^2 <= robust OLS
+variance) = \code{sigma2_hyper_p}.}
+
+\item{sigma2_hyper_p}{See \code{sigma2_shape}.}
+
+\item{step_incl_prob, step_incl_alpha, step_incl_beta}{Parameters of the inclusion prior.}
+
+\item{step_size_scale}{Dispersion tau of the MOM / iMOM prior, relative to the residual
+variance (see \code{\link{priorp2g}} to elicit it).}
+
+\item{cred_int}{Coverage of the reported credible intervals.}
+
+\item{do_split_Z}{Sample the break indicators unit by unit (recommended).}
+
+\item{do_cluster_s2}{Unit-specific residual variances.}
+
+\item{do_sv}{Stochastic volatility: an AR(1) log-variance process per unit (overrides
+\code{do_cluster_s2}); needs at least 20 time periods.}
+
+\item{sv_prior_mu_mean, sv_prior_mu_var}{Normal prior on the SV level (default mean: log OLS
+residual variance per unit).}
+
+\item{sv_prior_phi_a, sv_prior_phi_b}{Beta prior on (phi + 1) / 2 for the SV persistence.}
+
+\item{sv_prior_sigma_shape, sv_prior_sigma_rate}{Prior on the SV innovation variance.}
+
+\item{sv_backend}{\code{"internal"} (KSC mixture with FFBS) or \code{"stochvol"} (uses the
+\pkg{stochvol} package).}
+
+\item{do_check_outlier}{Also sample observation-level outlier indicators.}
+
+\item{outlier_prior}{Outlier component: \code{"imom"} or \code{"norm"}.}
+
+\item{outlier_incl_alpha, outlier_incl_beta}{Beta prior on the outlier probability.}
+
+\item{outlier_scale}{Scale of the outlier component relative to the residual variance.}
+
+\item{steps_to_check}{\code{"all"} or the indices of the break columns to consider.}
+
+\item{do_sparse_computation}{Use sparse matrices for the design (slower for small panels).}
+
+\item{do_geweke_test}{Fixed prior settings for a Geweke-type check (constant variance only).}
+}
+\value{
+An object of class \code{"ism"}: a list with posterior draws (\code{draws}: beta,
+  sigma2, sis = break sizes, omega = break indicators, iis = outlier indicators), the data
+  and design matrices (\code{data}), fitted values, posterior means (\code{coefs}), a
+  summary table with means, credible intervals and PIPs (\code{coef_list}), R-squared values
+  and run information (\code{meta}); with \code{do_sv = TRUE} also SV draws and the posterior
+  mean variance path.
+}
+\description{
+Gibbs sampler for a panel regression with unit-specific step shifts (structural breaks)
+and, optionally, outliers. Break indicators are sampled with non-local (MOM / iMOM) priors on
+the break sizes, using integrated likelihoods with the break sizes integrated out; break
+sizes are then drawn from their non-local posterior (Rossell and Telesca, 2017).
+}
+\details{
+The data must be sorted by unit and, within unit, by time (a balanced panel).
+
+
+The break indicators are drawn with the break sizes integrated out, so the sizes kept
+afterwards must be a draw from their conditional posterior given the selected breaks. If a
+unit's set of breaks did not change, its previous sizes already are such a draw and one Gibbs
+iteration is used; otherwise \code{rnlp_iter} iterations are run, with newly included breaks
+starting at the maximiser of their conditional posterior.
+}
+\examples{
+set.seed(1)
+sim <- contr_sim_breaks(n = 3, t = 20, nx = 0, iis = FALSE, sis = TRUE, const = TRUE,
+                        pos.outl = 0, pos.step = 10, outl.mean = 0, step.mean = 3,
+                        error.sd = 1)
+fit <- estimate_bisam(sim$data, do_constant = TRUE, Ndraw = 500, Nburn = 100,
+                      beta_prior = "f", step_size_prior = "imom", step_incl_prior = "bern",
+                      step_size_scale = priorp2g(0.01, 1, prior = "iMom"))
+head(sort(fit$coefs$omega, decreasing = TRUE))
+}
+\references{
+Rossell, D. and Telesca, D. (2017). Nonlocal priors for high-dimensional
+  estimation. Journal of the American Statistical Association, 112, 254-265.
+}
+\seealso{
+\code{\link{pip_window}}, \code{\link{contr_sim_breaks}}, \code{\link{priorp2g}}
+}
