+% Generated by roxygen2: do not edit by hand
+% Please edit documentation in R/contr_sim_breaks_fun.R
+\name{contr_sim_breaks}
+\alias{contr_sim_breaks}
+\title{Simulate panel data with step shifts and outliers}
+\usage{
+contr_sim_breaks(
+  n,
+  t,
+  nx,
+  iis = TRUE,
+  sis = TRUE,
+  pos.outl,
+  pos.step,
+  const = FALSE,
+  ife = FALSE,
+  tfe = FALSE,
+  outl.mean,
+  step.mean,
+  error.sd
+)
+}
+\arguments{
+\item{n}{Number of units.}
+
+\item{t}{Number of time periods.}
+
+\item{nx}{Number of covariates (standard Normal, coefficients drawn from -10:10).}
+
+\item{iis, sis}{Kept for compatibility (outliers and steps are set by \code{pos.outl},
+\code{pos.step}).}
+
+\item{pos.outl}{Positions of outliers in the stacked panel (unit-major order), or 0.}
+
+\item{pos.step}{Positions of step shifts in the stacked panel (unit-major order).}
+
+\item{const, ife, tfe}{Include a constant, unit fixed effects and/or time fixed effects
+(coefficients drawn from -10:10). With both fixed effects and no constant the first unit
+effect is dropped.}
+
+\item{outl.mean}{Size of the outliers.}
+
+\item{step.mean}{Size of the step shifts.}
+
+\item{error.sd}{Standard deviation of the Normal errors.}
+}
+\value{
+A list with \code{data} (matrix with columns n, t, y and covariates), the true
+  coefficients (\code{true.b}, \code{true.const}, \code{true.ife}, \code{true.tfe}), the
+  errors and \code{tr.idx} (size, position and relative net effect of each outlier and step).
+}
+\description{
+Generates a balanced panel \code{y = X b + outliers + Z g + e} with unit-specific step
+shifts (\code{Z} holds the step dummies used by \code{\link{estimate_bisam}}) and
+observation-level outliers at given positions.
+}
+\examples{
+set.seed(1)
+sim <- contr_sim_breaks(n = 3, t = 20, nx = 1, iis = FALSE, sis = TRUE, const = TRUE,
+                        pos.outl = 0, pos.step = 10, outl.mean = 0, step.mean = 3,
+                        error.sd = 1)
+head(sim$data)
+}
